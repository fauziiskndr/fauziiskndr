    h1{margin:0;font-size:30px}
    p.lead{margin:6px 0;color:var(--muted)}
    .grid{display:grid;grid-template-columns:1fr 320px;gap:24px;margin-top:24px}
    .card{background:var(--card);padding:20px;border-radius:14px;box-shadow:0 8px 22px rgba(2,6,23,0.5)}
    .section-title{font-weight:600;margin-bottom:12px;color:var(--accent)}
    .biodata dl{display:grid;grid-template-columns:120px 1fr;row-gap:8px}
    .skills{display:flex;flex-wrap:wrap;gap:8px}
    .skill{background:var(--glass);padding:6px 12px;border-radius:999px;font-size:13px;color:var(--muted)}
    .hobbies{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .hobby{background:var(--glass);padding:6px 12px;border-radius:999px;font-size:13px;color:var(--muted)}
    .btn{display:inline-block;padding:10px 14px;border-radius:10px;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#04263a;font-weight:700;text-decoration:none}
    footer{margin-top:28px;color:var(--muted);font-size:13px;text-align:center}
    .photo-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-top:12px}
    .photo-gallery div{background:var(--glass);border-radius:12px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:13px}
    @media(max-width:880px){.grid{grid-template-columns:1fr}.avatar{width:90px;height:90px}}
